// EcoGuide Formosa — modelo de datos
// Plataforma de ecoturismo digital: puntos, audioguías, clips verticales,
// rutas, comunidad de guías y moderación.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  GUIDE
  ADMIN
}

enum Language {
  ES
  GN
  EN
}

enum PointStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum PointCategory {
  RESERVA_NATURAL
  PARQUE_NACIONAL
  RIO
  LAGUNA
  MONUMENTO
  CULTURA
  SENDERISMO
  COMUNIDAD
}

enum RouteDifficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionKind {
  TEXT
  AUDIO
  VIDEO
}

enum VisitSource {
  MAP
  QR
  ROUTE
  SEARCH
  SHARE
}

// ---------------------------------------------------------------- auth

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  role          UserRole  @default(TOURIST)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile    GuideProfile?
  accounts   Account[]
  sessions   Session[]
  points     PointOfInterest[]
  narrations AudioGuide[]
  routes     Route[]
  reviews    Review[]
  favorites  Favorite[]
  visits     Visit[]
  routeRuns  RouteVisit[]
  submissions ContentSubmission[] @relation("SubmissionsAuthored")
  reviewed   ContentSubmission[] @relation("SubmissionsReviewed")
  events     AnalyticsEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        String?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- comunidad

model GuideProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String?  @db.Text
  phone        String?
  whatsapp     String?
  instagram    String?
  coverImage   String?
  region       String?
  languages    Language[] @default([ES])
  specialties  String[]
  rating       Float    @default(0)
  totalReviews Int      @default(0)
  isVerified   Boolean  @default(false)
  isDemo       Boolean  @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- contenido

model PointOfInterest {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @db.Text
  shortDesc   String?       @db.Text
  latitude    Float
  longitude   Float
  altitude    Float?
  address     String?
  region      String?
  category    PointCategory
  tags        String[]
  status      PointStatus   @default(DRAFT)
  qrCode      String?       @unique
  coverImage  String?
  gallery     String[]
  regionKey   String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  creator     User           @relation(fields: [createdById], references: [id])
  audioGuides AudioGuide[]
  videos      VideoContent[]
  reviews     Review[]
  favorites   Favorite[]
  visits      Visit[]
  routeStops  RoutePoint[]

  @@index([status, category])
  @@index([region])
  @@index([latitude, longitude])
}

model AudioGuide {
  id         String   @id @default(cuid())
  pointId    String
  language   Language @default(ES)
  title      String
  script     String   @db.Text
  audioUrl   String
  duration   Int // segundos
  voice      String? // 'human' | 'tts'
  narratorId String?
  order      Int      @default(0)
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  point    PointOfInterest @relation(fields: [pointId], references: [id], onDelete: Cascade)
  narrator User?           @relation(fields: [narratorId], references: [id])

  @@index([pointId, language])
}

model VideoContent {
  id           String   @id @default(cuid())
  pointId      String
  title        String
  description  String?  @db.Text
  videoUrl     String
  thumbnailUrl String?
  duration     Int // segundos
  format       String   @default("vertical")
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  point PointOfInterest @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

model Route {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?          @db.Text
  coverImage  String?
  distance    Float? // km
  duration    Int? // minutos estimados
  difficulty  RouteDifficulty?
  theme       String?
  isPublic    Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  creator User        @relation(fields: [createdById], references: [id])
  stops   RoutePoint[]
  runs    RouteVisit[]

  @@index([isPublic])
}

model RoutePoint {
  id      String  @id @default(cuid())
  routeId String
  pointId String
  order   Int
  notes   String? @db.Text

  route Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  point PointOfInterest @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([routeId, order])
}

// ---------------------------------------------------------------- moderación

model ContentSubmission {
  id           String           @id @default(cuid())
  kind         SubmissionKind
  status       SubmissionStatus @default(PENDING)
  title        String
  body         String?          @db.Text
  audioUrl     String?
  videoUrl     String?
  coverImage   String?
  language     Language         @default(ES)
  duration     Int?
  authorId     String
  reviewNote   String?          @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  author     User  @relation("SubmissionsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SubmissionsReviewed", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- interacción

model Review {
  id        String   @id @default(cuid())
  pointId   String
  userId    String
  rating    Int // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  point PointOfInterest @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pointId, userId])
}

model Favorite {
  id        String   @id @default(cuid())
  pointId   String
  userId    String
  createdAt DateTime @default(now())

  point PointOfInterest @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pointId, userId])
}

model Visit {
  id        String      @id @default(cuid())
  pointId   String
  userId    String?
  visitedAt DateTime    @default(now())
  duration  Int? // segundos
  source    VisitSource @default(MAP)

  point PointOfInterest @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pointId, visitedAt])
}

model RouteVisit {
  id          String    @id @default(cuid())
  routeId     String
  userId      String
  progress    Int       @default(0) // porcentaje
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routeId, userId])
}

// ---------------------------------------------------------------- analítica

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  entityId  String?
  userId    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
}
